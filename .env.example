# No passwords here: users enter credentials in the connection dialog.
HOST=127.0.0.1
PORT=8080
KAMA_PORT=8080
# Replace with the PostgreSQL host reachable from the Node server/container.
PGHOST=localhost
PGPORT=5432
PGDATABASE=pgs_app_data_db
PG_METADATA_DATABASE=pgs_app_metadata_db
# Empty means exactly PGHOST:PGPORT. Multiple targets: db1:5432,db2:5432
PG_ALLOWED_TARGETS=
# Same-origin only by default. With HTTPS reverse proxy add its public origin.
# Example: https://kama.example.org (no trailing slash)
CORS_ORIGINS=
# Legacy TLS-off / unverified TLS requires this explicit administrator opt-in.
ALLOW_INSECURE_PG=false
# ClickHouse is reached directly from users' browsers.
CH_HOST=
CH_PORT=443
CH_PROTO=https
# For private CA: NODE_EXTRA_CA_CERTS=/absolute/path/to/ca.pem
